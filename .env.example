# Copy this file to `.env` and adjust the values for your environment.

# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins during development.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Search / scraping settings
# ---------------------------------------------------------------------------
# Results are fetched directly from DuckDuckGo's HTML endpoint. No API key is
# needed, and no paid scraping provider is used.
# Pages to scan per keyword (10 pages ≈ 100 organic results; max 10)
MAX_RESULT_PAGES=10
# Stop after this many organic links have been read (max 100)
TARGET_ORGANIC_RESULTS=100
# Delay between pages in milliseconds (keeps requests polite)
REQUEST_DELAY_MS=1200
# Per-request timeout in milliseconds
REQUEST_TIMEOUT_MS=15000
# Retry blocked direct requests through the free Jina Reader proxy
# (no API key required; recommended on datacenter hosts such as Vercel)
DDG_PROXY_FALLBACK=true
