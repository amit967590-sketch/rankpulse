# Copy this file to `.env` and adjust the values for your environment.

# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins during development.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Search / scraping settings
# ---------------------------------------------------------------------------
# Primary search engine: google (default) or duckduckgo
SEARCH_ENGINE=google
# Fall back to DuckDuckGo when Google returns a captcha/consent page
DUCKDUCKGO_FALLBACK=true
# Pages to scan per keyword (5 pages ≈ 50 organic results; max 10)
MAX_RESULT_PAGES=5
REQUEST_DELAY_MS=1000
REQUEST_TIMEOUT_MS=15000

# Optional API key for a search provider (e.g. SerpAPI, Bing, Google)
SEARCH_API_KEY=

# ScraperAPI key. When set, Google searches are proxied through
# https://api.scraperapi.com to avoid datacenter-IP blocking.
SCRAPER_API_KEY=

# Optional custom User-Agent for outbound requests
USER_AGENT=Mozilla/5.0 (compatible; SEOKeywordRankChecker/1.0)
