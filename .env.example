# Copy this file to `.env` and adjust the values for your environment.

# ---------------------------------------------------------------------------
# Server configuration
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed CORS origins.
# Leave empty to allow all origins during development.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ---------------------------------------------------------------------------
# Search / scraping settings (used by later rank-checking modules)
# ---------------------------------------------------------------------------
# 10 pages ≈ 100 organic results (deep scan for lower-ranking domains)
MAX_RESULT_PAGES=10
REQUEST_DELAY_MS=1000
REQUEST_TIMEOUT_MS=15000

# Optional API key for a search provider (e.g. SerpAPI, Bing, Google)
SEARCH_API_KEY=

# Optional custom User-Agent for outbound requests
USER_AGENT=Mozilla/5.0 (compatible; SEOKeywordRankChecker/1.0)
